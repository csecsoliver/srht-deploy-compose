[sr.ht]
site-name={{SITE_NAME}}
site-info=https://{{DOMAIN}}
site-blurb={{SITE_BLURB}}
environment=production
owner-name={{OWNER_NAME}}
owner-email={{OWNER_EMAIL}}
source-url=https://git.sr.ht/~sircmpwn/srht
service-key={{SERVICE_KEY}}
network-key={{NETWORK_KEY}}
redis-host=redis://:{{REDICT_PASSWORD}}@redict:6379/0
global-domain={{DOMAIN}}

[mail]
smtp-host={{SMTP_HOST}}
smtp-port={{SMTP_PORT}}
smtp-user={{SMTP_USER}}
smtp-password={{SMTP_PASSWORD}}
smtp-from={{SMTP_FROM}}
smtp-encryption={{SMTP_ENCRYPTION}}
smtp-auth={{SMTP_AUTH}}
error-to={{OWNER_EMAIL}}
error-from={{SMTP_FROM}}
pgp-privkey=/etc/sr.ht/pgp/privkey.asc
pgp-pubkey=/etc/sr.ht/pgp/pubkey.asc
pgp-key-id={{PGP_KEY_ID}}

[webhooks]
private-key={{WEBHOOK_PRIVATE_KEY}}

[objects]
s3-upstream=silo:9000
s3-insecure=yes
s3-region=us-east-1
s3-access-key={{S3_ACCESS_KEY}}
s3-secret-key={{S3_SECRET_KEY}}

[meta.sr.ht]
origin=https://meta.{{DOMAIN}}
internal-origin=http://meta:5000
api-origin=https://meta.{{DOMAIN}}
api-internal-origin=http://meta-api:5100
connection-string=postgresql://meta:{{DB_META_PASSWORD}}@postgres/meta.sr.ht?sslmode=disable
migrate-on-upgrade=yes
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1
welcome-emails=no
avatar-bucket=sourcehut
avatar-prefix=meta/avatars

[meta.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[meta.sr.ht::settings]
registration=yes
onboarding-redirect=https://git.{{DOMAIN}}
user-invites=5
email-default-domain={{DOMAIN}}

[meta.sr.ht::billing]
enabled=no

[git.sr.ht]
origin=https://git.{{DOMAIN}}
internal-origin=http://git:5001
api-origin=https://git.{{DOMAIN}}
api-internal-origin=http://git-api:5101
connection-string=postgresql://git:{{DB_GIT_PASSWORD}}@postgres/git.sr.ht?sslmode=disable
migrate-on-upgrade=yes
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1
post-update-script=/usr/bin/git.sr.ht-update-hook
shell=/usr/bin/git.sr.ht-shell
enable-dispatch=yes
repos=/var/lib/git/
s3-bucket=sourcehut
s3-prefix=git
outgoing-domain={{DOMAIN}}

[git.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[hg.sr.ht]
origin=https://hg.{{DOMAIN}}
internal-origin=http://hg:5010
api-origin=https://hg.{{DOMAIN}}
api-internal-origin=http://hg-api:5110
connection-string=postgresql://hg:{{DB_HG_PASSWORD}}@postgres/hg.sr.ht?sslmode=disable
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1
migrate-on-upgrade=yes
changegroup-script=/usr/bin/hg.sr.ht-hook-changegroup
repos=/var/lib/mercurial/
shell=/usr/bin/hg.sr.ht-shell
enable-dispatch=yes

[hg.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[todo.sr.ht]
origin=https://todo.{{DOMAIN}}
internal-origin=http://todo:5003
api-origin=https://todo.{{DOMAIN}}
api-internal-origin=http://todo-api:5103
connection-string=postgresql://todo:{{DB_TODO_PASSWORD}}@postgres/todo.sr.ht?sslmode=disable
migrate-on-upgrade=yes
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1
notify-from=todo@{{DOMAIN}}

[todo.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[todo.sr.ht::mail]
posting-domain=

[man.sr.ht]
origin=https://man.{{DOMAIN}}
internal-origin=http://man:5004
api-origin=https://man.{{DOMAIN}}
api-internal-origin=http://man-api:5104
connection-string=postgresql://man:{{DB_MAN_PASSWORD}}@postgres/man.sr.ht?sslmode=disable
migrate-on-upgrade=yes
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1

[man.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[paste.sr.ht]
origin=https://paste.{{DOMAIN}}
internal-origin=http://paste:5011
api-origin=https://paste.{{DOMAIN}}
api-internal-origin=http://paste-api:5111
connection-string=postgresql://paste:{{DB_PASTE_PASSWORD}}@postgres/paste.sr.ht?sslmode=disable
migrate-on-upgrade=yes
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1

[paste.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[pages.sr.ht]
origin=https://pages.{{DOMAIN}}
internal-origin=http://pages:5112
api-origin=https://pages.{{DOMAIN}}
api-internal-origin=http://pages:5112
connection-string=postgresql://pages:{{DB_PAGES_PASSWORD}}@postgres/pages.sr.ht?sslmode=disable
migrate-on-upgrade=yes
s3-bucket=sourcehut
s3-prefix=pages
user-domain=sites.{{DOMAIN}}
max-site-size=1024
gemini-certs=/var/lib/pages/certs

[pages.sr.ht::api]
internal-ipnet=127.0.0.0/8,::1/128,172.16.0.0/12

[hub.sr.ht]
origin=https://hub.{{DOMAIN}}
internal-origin=http://hub:5014
api-origin=https://hub.{{DOMAIN}}
api-internal-origin=http://hub-api:5114
connection-string=postgresql://hub:{{DB_HUB_PASSWORD}}@postgres/hub.sr.ht?sslmode=disable
migrate-on-upgrade=yes
webhooks=redis://:{{REDICT_PASSWORD}}@redict:6379/1
