/core.sr.ht/
/meta.sr.ht/
/todo.sr.ht/
/scm.sr.ht/
/git.sr.ht/
/hg.sr.ht/
/hg-upstream/
/builds.sr.ht/
/lists.sr.ht/
/pages.sr.ht/
/hub.sr.ht/
/man.sr.ht/
/paste.sr.ht/
/sr.ht-nginx/

# Local build/runtime output.
/data/
/backups/

# Python validation/runtime artifacts.
__pycache__/
*.py[cod]
